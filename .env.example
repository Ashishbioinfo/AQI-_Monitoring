# CPCB real-time AQI data is published via data.gov.in's open data API.
# Get a free API key at: https://www.data.gov.in/ (sign up -> My Account -> API Key)
# Resource used: "Real time Air Quality Index from various locations" (CPCB)
#   https://www.data.gov.in/resource/real-time-air-quality-index-various-locations
CPCB_API_KEY=your_data_gov_in_api_key_here

# Optional fallback provider (https://aqicn.org/data-platform/token/) if CPCB
# coverage for Nagpur is ever insufficient. Leave blank if unused.
WAQI_API_TOKEN=
