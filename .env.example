# This project tries multiple AQI data sources in order (see
# src/config.py DATA_SOURCE_PRIORITY), falling back automatically if one
# fails or has no key configured. You do not need all three — OpenAQ alone
# is enough to get started.

# --- OpenAQ (recommended: free, open data, email-only signup) ---
# Get a free key at: https://explore.openaq.org/register
OPENAQ_API_KEY=

# --- CPCB real-time feed via data.gov.in (official Govt of India source) ---
# Requires signing in via the Janparichay government SSO (data.gov.in -> My
# Account -> API Key). Optional if you're using OpenAQ/WAQI instead.
#   https://www.data.gov.in/resource/real-time-air-quality-index-various-locations
CPCB_API_KEY=

# --- WAQI (aqicn.org) fallback, free for non-commercial use ---
# Token: https://aqicn.org/data-platform/token/
WAQI_API_TOKEN=
